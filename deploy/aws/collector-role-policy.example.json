{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "IamInventoryOnly", "Effect": "Allow", "Action": "iam:GetAccountAuthorizationDetails", "Resource": "*"},
    {"Sid": "ManagedPolicyRead", "Effect": "Allow", "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"], "Resource": ["arn:aws:iam::123456789012:policy/*", "arn:aws:iam::aws:policy/*"]},
    {"Sid": "OwnedBucketInventory", "Effect": "Allow", "Action": "s3:ListAllMyBuckets", "Resource": "*"},
    {"Sid": "SandboxBucketMetadataOnly", "Effect": "Allow", "Action": ["s3:GetBucketPolicy", "s3:GetBucketTagging", "s3:GetEncryptionConfiguration", "s3:GetBucketOwnershipControls"], "Resource": "arn:aws:s3:::zerograph-qualification-*", "Condition": {"StringEquals": {"s3:ResourceAccount": "123456789012"}}},
    {"Sid": "OptionalAccessAdvisorJobs", "Effect": "Allow", "Action": "iam:GenerateServiceLastAccessedDetails", "Resource": ["arn:aws:iam::123456789012:role/*", "arn:aws:iam::123456789012:user/*"]},
    {"Sid": "OptionalAccessAdvisorResults", "Effect": "Allow", "Action": "iam:GetServiceLastAccessedDetails", "Resource": "*"},
    {"Sid": "OptionalOrganizationDescription", "Effect": "Allow", "Action": "organizations:DescribeOrganization", "Resource": "*"},
    {"Sid": "OptionalOrganizationParents", "Effect": "Allow", "Action": "organizations:ListParents", "Resource": ["arn:aws:organizations::111122223333:account/o-example/123456789012", "arn:aws:organizations::111122223333:ou/o-example/*"]},
    {"Sid": "OptionalScpAttachments", "Effect": "Allow", "Action": "organizations:ListPoliciesForTarget", "Resource": ["arn:aws:organizations::111122223333:account/o-example/123456789012", "arn:aws:organizations::111122223333:ou/o-example/*", "arn:aws:organizations::111122223333:root/o-example/*"], "Condition": {"StringEquals": {"organizations:PolicyType": "SERVICE_CONTROL_POLICY"}}},
    {"Sid": "OptionalGlueCatalogRead", "Effect": "Allow", "Action": ["glue:GetDatabases", "glue:GetTables", "glue:GetTags", "glue:GetResourcePolicy"], "Resource": ["arn:aws:glue:us-east-1:123456789012:catalog", "arn:aws:glue:us-east-1:123456789012:database/*", "arn:aws:glue:us-east-1:123456789012:table/*/*"]},
    {"Sid": "OptionalLakeFormationRead", "Effect": "Allow", "Action": ["lakeformation:GetDataLakeSettings", "lakeformation:ListPermissions", "lakeformation:ListLFTags", "lakeformation:ListLFTagExpressions", "lakeformation:SearchDatabasesByLFTags", "lakeformation:SearchTablesByLFTags"], "Resource": "*"},
    {"Sid": "OptionalAthenaWorkgroupList", "Effect": "Allow", "Action": "athena:ListWorkGroups", "Resource": "*"},
    {"Sid": "OptionalAthenaWorkgroupRead", "Effect": "Allow", "Action": "athena:GetWorkGroup", "Resource": "arn:aws:athena:us-east-1:123456789012:workgroup/*"},
    {"Sid": "OptionalScpDocuments", "Effect": "Allow", "Action": "organizations:DescribePolicy", "Resource": ["arn:aws:organizations::111122223333:policy/o-example/service_control_policy/*", "arn:aws:organizations::aws:policy/service_control_policy/*"], "Condition": {"StringEquals": {"organizations:PolicyType": "SERVICE_CONTROL_POLICY"}}}
  ]
}
