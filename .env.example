# Generate random development secrets with: python3 deploy/init_env.py
ZG_ENVIRONMENT=development
ZG_DEMO_MODE=true
ZG_DEMO_TOKEN=replace-with-random-64-character-token
ZG_SESSION_SECRET=replace-with-random-64-character-secret
ZG_COOKIE_SECURE=false
ZG_PUBLIC_URL=http://localhost:3100
POSTGRES_PASSWORD=replace-with-random-password
ZG_GRAPH_VENDOR=memgraph
ZG_GRAPH_USERNAME=
ZG_GRAPH_PASSWORD=
ZG_OIDC_ISSUER=
ZG_OIDC_AUDIENCE=zerograph-api
ZG_OIDC_JWKS_URL=
ZG_OIDC_CLIENT_ID=
ZG_OIDC_CLIENT_SECRET=
ZG_OIDC_SCOPE=openid profile
ZG_TENANT_CLAIM=tenant_id
ZG_ROLE_CLAIM=roles
ZG_AWS_TENANT_ID=
ZG_AWS_ROLE_ARN=
ZG_AWS_EXTERNAL_ID=
ZG_AWS_REGION=us-east-1
ZG_GIT_PROVIDER=github
ZG_GIT_TENANT_ID=
ZG_GIT_REPOSITORY=
ZG_GIT_BASE_BRANCH=main
